PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES=7d

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=notif_platform

REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP (laisser SMTP_HOST vide = les emails sont simplement affichés dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Notif Platform <no-reply@notif.local>"

# Clés VAPID pour le push navigateur : npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@notif.local
